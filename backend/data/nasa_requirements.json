  {
    "id": "V1-4003",
    "category": "aerobic_capacity",
    "name": "In-Mission Aerobic Capacity Retention",
    "description": "Compare in-mission aerobic capacity with the individual's premission baseline.",
    "metric": "vo2max_percent_of_premission",
    "operator": ">=",
    "threshold": 80,
    "unit": "%",
    "missions": [
      "ISS_EVA",
      "LUNAR_EVA",
      "MARS_EVA"
    ],
    "phase": "in_mission",
    "measurement": {
      "method": "comparison_with_premission_vo2max",
      "requires_measured_value": true,
      "requires_baseline": true,
      "baseline_metric": "premission_vo2max",
      "current_metric": "vo2max",
      "formula": "(vo2max / premission_vo2max) * 100",
      "validity_days": null
    },
    "evaluation": {
      "missing_data_status": "NOT_ASSESSED",
      "requires_medical_review": true
    },
    "source": {
      "standard": "NASA-STD-3001 Volume 1",
      "revision": "C",
      "section": "4.1.3",
      "requirement": "V1 4003",
      "url": "https://standards.nasa.gov/standard/NASA/NASA-STD-3001_VOL_1",
      "verified": false
    }
  },
